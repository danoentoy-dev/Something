local color = Color3.fromRGB(148, 0, 211)
local gunChamsEnabled = false

function changeWeaponLook(gun)
    if not gun then return end

    local parts = gun:FindFirstChild("Weapon")
    if not parts then return end

    for _, v in pairs(parts:GetDescendants()) do
        if v:IsA("BasePart") and v.Transparency < 1 then
            v.Material = Enum.Material.ForceField
            v.Color = color
        end

        if v:IsA("SurfaceAppearance") then
            v:Destroy()
        end
    end
end

function setupWeaponChanger()
    local cam = workspace.Camera
    local currentGun = cam:FindFirstChild("CurrentWeapon")

    if currentGun then
        changeWeaponLook(currentGun)
    end

    workspace.Camera.ChildAdded:Connect(function(obj)
        if obj.Name == "CurrentWeapon" then
            wait(0.1)
            changeWeaponLook(obj)
        end
    end)
end

