local function SelfChams()
    local EntitiesFolder = workspace.game_assets.Entities  -- Updated folder path
    if EntitiesFolder then
        for _, character in pairs(EntitiesFolder:GetChildren()) do
            for _, part in pairs(character:GetChildren()) do
                if part:IsA("BasePart") and table.find({
                    "Head", "LeftFoot", "LeftHand", "LeftLowerArm", "LeftLowerLeg",
                    "LeftUpperArm", "LeftUpperLeg", "LowerTorso", "RightFoot",
                    "RightHand", "RightLowerArm", "RightLowerLeg", "RightUpperArm",
                    "RightUpperLeg", "UpperTorso"
                }, part.Name) then
                    part.Material = Enum.Material.ForceField
                    part.Color = Self_Chams_Color
                end

                if part:IsA("BasePart") then
                    local clothingToRemove = {
                        ["LeftFoot"]       = "Pants",
                        ["LeftHand"]       = "Shirt",
                        ["LeftLowerArm"]   = "Shirt",
                        ["LeftLowerLeg"]   = "Pants",
                        ["LeftUpperArm"]   = "Shirt",
                        ["LeftUpperLeg"]   = "Pants",
                        ["LowerTorso"]     = "Shirt",
                        ["RightFoot"]      = "Pants",
                        ["RightHand"]      = "Shirt",
                        ["RightLowerArm"]  = "Shirt",
                        ["RightLowerLeg"]  = "Pants",
                        ["RightUpperArm"]  = "Shirt",
                        ["RightUpperLeg"]  = "Pants",
                        ["UpperTorso"]     = "Shirt", 
                    }

                    local clothingType = clothingToRemove[part.Name]
                    if clothingType then
                        local item = part:FindFirstChild(clothingType)
                        if item then
                            item:Destroy()
                        end
                    end
                end
            end
        end
    end
end


