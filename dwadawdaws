    }

    function aftermath.packet_manipulation.serialize(buf, struct)
        if typeof(buf) ~= "buffer" then
            return --print('grr...')
        end

        return serializers[struct](buf)
    end

    function aftermath.packet_manipulation.encode(serialized)
        if typeof(serialized) ~= "table" then
            return --print('grr...')
        end

        local encoded = binutil.new()
        for _, data in serialized do
            binutil["Write"..data.data_type](
